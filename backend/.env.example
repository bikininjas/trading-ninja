# ============================================================================
# Trading Ninja — configuration
# Copier en .env et ajuster. Aucune valeur secrète ne doit être commitée.
# ============================================================================

# --- Mode d'exécution -------------------------------------------------------
# paper  : aucun ordre réel n'est envoyé (phases 0 et 1). C'est le défaut.
# live   : argent réel. Exige AUSSI I_UNDERSTAND_REAL_MONEY=true.
TRADING_MODE=paper
ENV=development
DEBUG=true
TZ=UTC

# Verrou d'armement : à ne passer à true qu'en connaissance de cause.
I_UNDERSTAND_REAL_MONEY=false

# --- Profil de risque -------------------------------------------------------
# prudent | standard | aggressive | micro
# micro : compte de quelques euros. Le minimum d'ordre de l'exchange impose un
#         plancher en valeur absolue ; le risque par trade monte en pourcentage
#         mais reste sous 0,20 EUR. Voir docs/KRAKEN.md §7.
# Les variables RISK_* ci-dessous écrasent le preset si elles sont définies.
RISK_PROFILE=prudent

# --- Boutons du risque (laisser vide = valeur du preset) --------------------
# RISK_PER_TRADE_PCT=0.005        # fraction de l'équité risquée par trade
# MAX_NOTIONAL_PCT=0.20           # exposition max par position, en fraction de l'équité
# MAX_POSITION_NOTIONAL_QUOTE=2000  # plafond absolu en USDT, anti-bug
# STOP_ATR_MULTIPLE=2.5           # distance du stop = N x ATR du timeframe de décision
# TAKE_PROFIT_R_MULTIPLE=2.0      # 0 = pas de TP (sortie par stop uniquement)
# MIN_CONFIDENCE=0.80
# MAX_DAILY_DRAWDOWN_PCT=0.02
# MAX_WEEKLY_DRAWDOWN_PCT=0.05
# MAX_DRAWDOWN_FROM_HWM_PCT=0.10
# MAX_CONSECUTIVE_LOSSES=4
# RISK_THROTTLE_AFTER_LOSSES=2
# RISK_THROTTLE_FACTOR=0.5
# MAX_ORDERS_PER_HOUR=6
# STALE_DATA_SECONDS=5
# MAX_OPEN_POSITIONS=1
# TREND_BUFFER_PCT=0.005
# FALLING_KNIFE_ATR_MULTIPLE=2.5
# MIN_ATR_PCT_OF_PRICE=0.0015
# MAX_ATR_PCT_OF_PRICE=0.08

# --- Marché -----------------------------------------------------------------
# Symboles unifiés CCXT : BTC/USDT, BTC/EUR, ETH/EUR...
# TRADING_SYMBOLS liste les paires autorisées ; TRADING_SYMBOL reste la principale.
TRADING_SYMBOL=BTC/USDT
# TRADING_SYMBOLS=BTC/EUR,ETH/EUR
DECISION_TIMEFRAME=4h
ENTRY_TIMEFRAME=1h

# --- Exchange ---------------------------------------------------------------
# binance | kraken
EXCHANGE_ID=binance
EXCHANGE_SANDBOX_MODE=true
# Noms acceptés : EXCHANGE_API_KEY, ou BINANCE_API_KEY / KRAKEN_API_KEY
#                 EXCHANGE_SECRET,  ou BINANCE_SECRET_KEY / KRAKEN_SECRET
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# --- LLM local --------------------------------------------------------------
# Linux/WSL2 : http://127.0.0.1:11434/v1
# Docker      : http://host.docker.internal:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Le cahier des charges vise qwen2.5:14b-instruct ; sur la machine de dev,
# qwen3.5:9b répond en 1,0-1,5 s. `think=false` est imposé par le client.
LLM_MODEL_NAME=qwen3.5:9b
# 4 s est la cible théorique ; mesuré 6,3 s avec réflexion, 1,5 s sans.
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0.0

# --- Exécution papier -------------------------------------------------------
# 0 = reprendre le solde réel en lecture au premier cycle.
PAPER_START_EQUITY=0
PAPER_SLIPPAGE_BPS=5

# --- Profit Sweeper ---------------------------------------------------------
SWEEP_RATIO=0.30
SWEEP_MIN_TRANSFER_QUOTE=1.00

# --- Base de données (Supabase) ---------------------------------------------
# Rien à faire si .env.local contient NEXT_PUBLIC_SUPABASE_URL et le mot de
# passe : la connexion est dérivée automatiquement.
#
#   DATABASE_URL explicite (prioritaire) :
# DATABASE_URL=postgresql://postgres:motdepasse@db.<ref>.supabase.co:5432/postgres
#
# Connexion directe = IPv6 uniquement sur les projets Supabase récents.
# Si le réseau est IPv4 (Docker sans IPv6, VPS), basculer sur le pooler :
# SUPABASE_USE_POOLER=true
# SUPABASE_POOLER_REGION=eu-west-1   # région réelle du projet
#
# Variables reconnues pour le mot de passe :
# SUPABASE_DB_PASSWORD, SUPABASE_TRNINJA_PWD, SUPABASE_PWD, SUPABASE_PASSWORD

# --- Sécurité admin ---------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET_KEY=
MASTER_ENCRYPTION_KEY=
# scripts/totp_setup.py (compatible Authy : 6 chiffres, 30 s)
TOTP_SECRET=
# scripts/hash_password.py
ADMIN_PASSWORD_HASH=

CORS_ORIGINS=["http://localhost:3000"]
