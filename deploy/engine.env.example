# Copier hors dépôt dans /etc/trading-ninja/engine.env, propriétaire trading-ninja, mode 0600.
DATABASE_URL=
TRADING_SYMBOL=BTC/EUR
TRADING_SYMBOLS=BTC/EUR,ETH/EUR,SOL/EUR
QUOTE_CURRENCY=EUR
DECISION_TIMEFRAME=4h
ENTRY_TIMEFRAME=1h
RISK_PROFILE=micro_budget
# Profil PAPER pour 9,37 EUR ; limites définies ensemble dans le preset.
MAX_OPEN_POSITIONS=1
COST_AWARE=true
TAKER_FEE_PCT=0.008
PAPER_SLIPPAGE_BPS=5
# Capital VIRTUEL ; ne constitue aucune allocation du compte réel.
PAPER_START_EQUITY=9.37
CAPITAL_STEPS_ENABLED=false
INSIGHTS_ENABLED=true
RANKING_MODE=observe
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL_NAME=qwen3.5:9b
LLM_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=0
