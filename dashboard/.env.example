# Dashboard — configuration (copier en .env)
#
# Par défaut, l'interface n'écoute que sur la boucle locale.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8081

# Pour écouter sur le réseau, deux gestes sont exigés :
#   DASHBOARD_HOST=0.0.0.0
#   DASHBOARD_ALLOW_REMOTE=true
# Sans TLS devant, le mot de passe et le code Authy circulent en clair.

API_BASE_URL=http://127.0.0.1:8080
DASHBOARD_POLL_MS=2000

# true uniquement derrière HTTPS, sinon le cookie HttpOnly n'est jamais renvoyé.
DASHBOARD_COOKIE_SECURE=false
